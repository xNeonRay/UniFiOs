# ============================================================
# UniFi Captive Portal - Environment Configuration
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- UniFi Controller ---
# IP or hostname of the UniFi OS controller (no trailing slash)
UNIFI_IP=192.168.1.1

# HTTPS port used by the UniFi OS controller.
# Modern UniFi OS uses 443 (standard) or a custom port (e.g. 11443).
UNIFI_PORT=443

# API Key generated in UniFi OS → Settings → Admin → API Keys
UNIFI_API_KEY=your_api_key_here

# Whether to skip SSL certificate verification (true for self-signed certs)
UNIFI_IGNORE_SSL=true

# --- Multi-site (integration/v1) ---
# Comma-separated list of UniFi site UUIDs this portal manages.
# These are the "id" values from GET /proxy/network/integration/v1/sites/{topSiteId}/devices
# When a voucher is redeemed, the MAC will be authorized on ALL listed sites.
# Example: UNIFI_SITE_IDS=88f7af54-98f8-306a-a1c7-c9349722b1f6,001df191-5339-306a-a370-2875d376b630
UNIFI_SITE_IDS=

# Comma-separated list of site internalReferences (slugs) matching the UUIDs above.
# Used for stamgr commands via /proxy/network/api/s/{internalReference}/cmd/stamgr
# Example: UNIFI_SITE_REFS=default,9kjh0hv4
UNIFI_SITE_REFS=default

# Top-level site ID required for integration/v1 discovery calls.
# This is the "id" from GET /proxy/network/integration/v1/sites
# Leave blank to use the first result automatically.
UNIFI_TOP_SITE_ID=

# --- Database ---
# Path to the SQLite database file
DB_PATH=./data/unifi_portal.sqlite

# --- Admin ---
# Secret token required to call admin-only endpoints (Bearer header)
ADMIN_SECRET=change_me_super_secret_token_here

# --- Portal ---
# URL shown to the user after successful authorization
PORTAL_REDIRECT_URL=https://www.google.com

# Duration (seconds) to wait between connectivity poll retries in the frontend
PORTAL_POLL_INTERVAL_MS=2000

# Maximum number of connectivity poll attempts before showing an error
PORTAL_POLL_MAX_RETRIES=15
